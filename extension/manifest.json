{
  "manifest_version": 3,
  "name": "Crossword Labs Autofill",
  "version": "1.0.0",
  "description": "Fills in a Crossword Labs puzzle using the answer grid the page already sends to your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crossword Labs Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "homepage_url": "https://github.com/Trogiken/crossword-labs-autofill"
}
